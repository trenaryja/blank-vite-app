		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1",
		"daisyui": "^5.5.23",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6",
