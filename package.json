{
	"name": "blank-vite-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"fix": "biome check --write .",
		"check": "rm -rf dist && tsc && biome check . && bun run build",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install"
	},
	"dependencies": {
		"@trenaryja/ui": "^0.0.1-0",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2",
		"@tailwindcss/vite": "^4",
		"@types/node": "^25",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5",
		"babel-plugin-react-compiler": "^1",
		"daisyui": "^5",
		"tailwindcss": "^4",
		"typescript": "^6",
		"vite": "^7"
	},
	"trustedDependencies": [
		"esbuild",
		"sharp",
		"unrs-resolver"
	]
}
