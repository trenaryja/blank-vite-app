{
	"compilerOptions": {
		"target": "esnext",
		"jsx": "react-jsx",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": { "@/*": ["./src/*"] },
		"resolveJsonModule": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["node_modules", "dist"]
}
